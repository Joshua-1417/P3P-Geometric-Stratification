<Group labelreference="L411" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"><Font foreground="[0,128,0]"># A(0, 0, 0) B(s12, 0, 0) C(x3, y3, 0)</Font></Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L400" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">Heron := expand((s23 + s13 + s12) * (-s23 + s13 + s12) * (s23 - s13 + s12) * (s23 + s13 - s12));</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LV9JLFR5cGVzZXR0aW5nRzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliRzYiSSxtcHJpbnRzbGFzaEdGKDYkNyM+SSZIZXJvbkdGKCwuKiRJJHMxMkdGKCIiJSEiIiomRjAiIiNJJHMxM0dGKEY0RjQqJkYwRjRJJHMyM0dGKEY0RjQqJEY1RjFGMiomRjVGNEY3RjRGNCokRjdGMUYyNyNGLg==</Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L405" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">gd := d^2 - Heron:</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L397" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">R := (s23 * s13 * s12) / d:</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L399" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">x3 := (s13^2 + s12^2 - s23^2) / (2 * s12):
y3 := d / (2 * s12):
<Font foreground="[0,128,0]"># circle center coordinates(xo, yo)</Font>
xo := s12 / 2:
yo := s12 * (s23^2 + s13^2 - s12^2) / (2 * d):</Text-field>
</Input>
</Group>
<Group labelreference="L690" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">f1 := 8 * s23 * s13 * s12^2 * sin_^3 - 6 * s23 * s13 * s12^2 * sin_ - s23^4 + 2 * s23^2 * s13^2 + s23^2 * s12^2 - s13^4 + s13^2 * s12^2:</Text-field>
</Input>
</Group>
<Group labelreference="L705" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">f2 := 8 * s23 * s13 * s12^2 * cos_^3 - 6 * s23 * s13 * s12^2 * cos_ - d * s13^2 + d * s23^2:</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L413" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">f3 := numer(normal((xo + R * cos_ )^2 + (yo + R * sin_)^2 + h^2 - e1^2)):</Text-field>
</Input>
</Group>
<Group labelreference="L407" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">f4 := numer(normal((xo + R * cos_ - s12)^2 + (yo + R * sin_)^2 + h^2 - e2^2)):</Text-field>
</Input>
</Group>
<Group labelreference="L410" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">f5 := numer(normal((xo + R * cos_ - x3)^2 + (yo + R * sin_ - y3)^2 + h^2 - e3^2)):</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L398" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">f6 := sin_^2 + cos_^2 - 1:</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L402" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">I5 := EliminationIdeal(Saturate(PolynomialIdeal(gd, f1, f2, f3, f4, f5, f6), s12 * s13 * s23 * d), {s12, s13, s23, e1, e2, e3});</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L408" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
