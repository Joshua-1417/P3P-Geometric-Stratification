<Group view="code" labelreference="L696" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">IdealSat := proc(Jbase, Kremove)
    local R, g;
    R := PolynomialIdeal(1);
    for g in Kremove do
        R := Intersect(R, Saturate(Jbase, g));
    end do;
    return Simplify(R);
end proc:</Text-field>
</Input>
</Group>
