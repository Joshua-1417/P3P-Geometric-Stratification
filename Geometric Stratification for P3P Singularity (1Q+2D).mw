<Section collapsed="false" isCollapsible="true" drawButton="true" MultipleChoiceAnswerIndex="-1" MultipleChoiceRandomizeChoices="false" TrueFalseAnswerIndex="-1" EssayAnswerRows="5" EssayAnswerColumns="60"><Title><Text-field style="Heading 1" layout="Heading 1">3. Geometric Stratification for Singular Configurations</Text-field></Title>
<Group labelreference="L311" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field style="Text" layout="Normal"><Font bold="true">Define three P3P equations.(the three cosine theorems for a tetrahedron)</Font></Text-field>
</Input>
</Group>
<Group labelreference="L309" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">f := [e2^2 + e3^2 - 2 * e2 * e3 * A - s23^2, e1^2 + e3^2 - 2 * e1 * e3 * B - s13^2, e1^2 + e2^2 - 2 * e1 * e2 * C - s12^2]:
var := [e1, e2, e3]:</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L313" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">smplist := [A = (e2^2 + e3^2 - s23^2) / (2 * e2 * e3), B = (e1^2 + e3^2 - s13^2) / (2 * e1 * e3), C = (e1^2 + e2^2 - s12^2) / (2 * e1 * e2)]:</Text-field>
</Input>
</Group>
<Group labelreference="L312" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field style="Text" bold="true" layout="Normal"><Font bold="true">Compute the Jacobian matrix of the P3P equations with respect to ei.</Font></Text-field>
</Input>
</Group>
<Group labelreference="L315" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">J := Jacobian(f, [e1, e2, e3]):</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L314" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">simplify(subs(smplist, J));</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group labelreference="L306" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field style="Text" layout="Normal"><Font bold="true">The left and right null vectors of the Jacobian.(Assuming J[2, 3]<Font encoding="UTF-8">\342\211\2400 and J[3, 2]\342\211\2400)</Font></Font></Text-field>
</Input>
</Group><Presentation-Block>
<Group view="code" hide-input="false" labelreference="L307" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">m := - J[1, 3] / J[2, 3]:
n := - J[1, 2] / J[3, 2]:
p := - J[3, 1] / J[3, 2]:
q := - J[2, 1] / J[2, 3]:</Text-field>
</Input>
</Group>
<Group view="code" hide-input="false" labelreference="L308" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">u_null := simplify(convert(subs(smplist, Vector([1, m, n])),Matrix));</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
