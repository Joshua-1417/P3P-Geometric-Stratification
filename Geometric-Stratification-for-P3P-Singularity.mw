<Group hide-input="false" labelreference="L397" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">R := (s23 * s13 * s12) / (sqrt ((s23 + s13 + s12) * (-s23 + s13 + s12) * (s23 - s13 + s12) * (s23 + s13 - s12))):</Text-field>
</Input>
