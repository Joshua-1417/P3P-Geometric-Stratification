<Group view="code" labelreference="L694" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">para_list := Matrix(2, 3, symbol = a):
lambda_last := J . Vector([1, para_list[1, 1], para_list[2, 1]]):
lambda_list := Matrix(lambda_last):
delta_last := Jacobian(lambda_last, var) . Vector([1, para_list[1, 1], para_list[2, 1]]):
delta_list := Matrix([J[1 .. -1, 1], delta_last]):
for mu from 2 to 3 do
    lambda_last := delta_last / mu + J . Vector([0, para_list[1, mu], para_list[2, mu]]):
    lambda_list := Matrix([lambda_list, lambda_last]):
    temp := lambda_last . Transpose(Vector([1, para_list[1, 1], para_list[2, 1]])):
    for k from 2 to mu do
        temp := temp + k * lambda_list[1 .. -1, -k] . Transpose(Vector([0, para_list[1, k], para_list[2, k]]));
    od:
    delta_last := Vector(3):
    for k from 1 to 3 do 	
		delta_last := delta_last + diff(temp[1 .. -1, k], var[k]): 
    od:
    delta_list := Matrix([delta_list, delta_last]):
od:</Text-field>
</Input>
</Group>
<Group view="code" hide-input="false" labelreference="L695" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">evlist := smplist:
for i from 1 to 3 do
    evlist := [op(evlist), op(solve(subs(evlist, {lambda_list[2, i] = 0, lambda_list[3, i] = 0}), {para_list[1, i], para_list[2, i]}))]:
    Delta[i] := numer(subs(evlist, BilinearForm(Vector([1, m, n]), delta_list[1 .. -1, i], conjugate = false))):
od:
Delta[1] := Delta[1] / (2 * e2 * e3);
Delta[2] := Delta[2] / (2 * e2^2 * e3^2);
Delta[3] := Delta[3] / (-12 * e2^2 * e3^2);</Text-field>
</Input>
